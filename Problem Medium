#include <iostream>
#include <vector>
using namespace std;

void moveZeroes(vector<int>& arr) {
    int n = arr.size();

    int i = 0;
    int j = 0;

    while (i < n) {
        if (arr[i] != 0) {
            swap(arr[i], arr[j]);
            j++;
        }
        i++;
    }
}

int main() {
    vector<int> arr = {0, 1, 0, 3, 12, 0, 5};

    moveZeroes(arr);

    for (int x : arr) {
        cout << x << " ";
    }

    return 0;
}
