#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

unordered_map<int, int> frequency(vector<int>& arr) {
    unordered_map<int, int> mp;

    for (int x : arr) {
        mp[x]++;
    }

    return mp;
}

int main() {
    vector<int> arr = {1, 2, 2, 3, 1, 4, 2};

    unordered_map<int, int> mp = frequency(arr);

    for (auto x : mp) {
        cout << x.first << " -> " << x.second << endl;
    }

    return 0;
}
