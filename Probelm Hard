#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

int longestSubarray(vector<int>& arr, int K) {

    unordered_map<int, int> mp;

    // Prefix sum 0 starts before the array
    mp[0] = -1;

    int currentSum = 0;
    int maxLength = 0;

    for (int i = 0; i < arr.size(); i++) {

        currentSum += arr[i];

        int required = currentSum - K;

        // If required prefix sum exists
        if (mp.find(required) != mp.end()) {
            int length = i - mp[required];
            maxLength = max(maxLength, length);
        }

        // Store only the first occurrence
        if (mp.find(currentSum) == mp.end()) {
            mp[currentSum] = i;
        }
    }

    return maxLength;
}

int main() {

    vector<int> arr = {10, 5, 2, 7, 1, 9};
    int K = 15;

    cout << longestSubarray(arr, K);

    return 0;
}
