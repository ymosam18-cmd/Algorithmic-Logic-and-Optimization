// Problem: Remove Duplicates from Sorted Array

int removeDuplicates(vector<int>& arr) {
    int n = arr.size();

    if (n == 0)
        return 0;

    int officer = 0;
    int cm = 1;

    while (cm < n) {

        if (arr[cm] == arr[cm - 1]) {
            cm++;
            continue;
        }

        arr[officer + 1] = arr[cm];

        officer++;
        cm++;
    }

    return officer + 1;
}
